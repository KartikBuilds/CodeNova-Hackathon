# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/learnAI?retryWrites=true&w=majority

# AI Configuration
GROQ_API_KEY=your-groq-api-key-from-https://console.groq.com

# AI Mock Mode (development/testing only)
# Set to 'true' ONLY in development environments to enable mock responses when Groq API is unavailable
# In production (NODE_ENV=production), missing GROQ_API_KEY will return 503 Service Unavailable
AI_MOCK_MODE=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
