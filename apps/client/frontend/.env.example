# Environment Variables for CodeNova Frontend

# API Configuration
# The backend API URL is required for all AI features
# In development: http://localhost:5000
# In production: https://your-backend-domain.com (or /api for same-origin)
VITE_API_URL=http://localhost:5000

# Application Configuration
VITE_APP_NAME=CodeNova - AI Learning Assistant
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Note: API keys are NEVER stored in frontend environment variables
# All AI features (flashcards, tutor chat, document analysis) are handled by the backend
# The backend requires GROQ_API_KEY to be set in its environment
